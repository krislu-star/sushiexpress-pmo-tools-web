# 本機設定範本：複製為 .env.local 後填入（.env.local 已列入 .gitignore，不會被提交）
# GitHub Actions 不讀這個檔案；正式排程請設定 repo 的 Secrets／Variables（見 README「一次性設定」）

# 服務帳號 JSON 金鑰：整段 JSON 放在同一行，外面用單引號包住（private_key 裡的 \n 保持原樣）
GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com"}'

# 頁面共用密碼（本機可用簡易密碼；或改設 PMO_ALLOW_PLAINTEXT=1 以明文開發）
PMO_ACCESS_PASSWORD=
# PMO_ALLOW_PLAINTEXT=1

# Email 通知（本機測試寄信用；不設定則略過寄信）
PMO_NOTIFY_EMAIL=
PMO_SMTP_HOST=
PMO_SMTP_PORT=465
PMO_SMTP_FROM=
PMO_SMTP_USER=
PMO_SMTP_PASSWORD=

# 會議頁編輯與存檔：設為 true 才開啟，未設定為唯讀（預設）；改完需重新執行 pnpm dev／build
# NEXT_PUBLIC_PMO_MEETING_EDIT=true

# （選填）子路徑；使用自訂網域（網站根目錄）時不設定
# NEXT_PUBLIC_BASE_PATH=

# （選填）通知信中的網站網址；GitHub Actions 由部署結果自動帶入
# PMO_SITE_URL=https://example.com/
