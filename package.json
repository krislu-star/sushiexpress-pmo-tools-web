{
  "name": "sushiexpress-pmo-tools-web",
  "version": "0.2.0",
  "private": true,
  "description": "爭鮮 IT 案件追蹤與管理層呈報儀表板",
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "dev": "pnpm snapshot:encrypt && next dev",
    "build": "pnpm snapshot:encrypt && next build",
    "lint": "next lint",
    "check:types": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "check:inline": "tsx scripts/check-inline-scripts.ts out",
    "e2e": "playwright test",
    "format:check": "prettier --check .",
    "snapshot:build": "tsx scripts/snapshot/buildSnapshot.ts",
    "build:perf": "PMO_SNAPSHOT=tests/fixtures/snapshot.500.json PMO_ACCESS_PASSWORD=e2e-password pnpm snapshot:encrypt && NEXT_PUBLIC_PMO_MEETING_EDIT=true PMO_OUT_DIR=out-perf next build",
    "e2e:perf": "PMO_PERF=1 playwright test",
    "build:e2e": "PMO_SNAPSHOT=tests/fixtures/snapshot.sample.json PMO_ACCESS_PASSWORD=e2e-password pnpm snapshot:encrypt && NEXT_PUBLIC_PMO_MEETING_EDIT=true PMO_OUT_DIR=out-e2e next build",
    "snapshot:fetch": "tsx --env-file-if-exists=.env.local scripts/snapshot/fetchSnapshot.ts",
    "snapshot:report": "tsx --env-file-if-exists=.env.local scripts/snapshot/updateReport.ts",
    "snapshot:notify": "tsx --env-file-if-exists=.env.local scripts/snapshot/notify.ts",
    "check:plaintext": "tsx scripts/check-plaintext.ts out",
    "snapshot:encrypt": "tsx --env-file-if-exists=.env.local scripts/encryptSnapshot.ts",
    "check:plaintext:e2e": "tsx scripts/check-plaintext.ts out-e2e tests/fixtures/snapshot.sample.json",
    "build:e2e:readonly": "PMO_SNAPSHOT=tests/fixtures/snapshot.sample.json PMO_ACCESS_PASSWORD=e2e-password pnpm snapshot:encrypt && PMO_OUT_DIR=out-e2e-readonly next build",
    "e2e:readonly": "PMO_E2E_READONLY=1 playwright test e2e/meeting-readonly.spec.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.13",
    "@radix-ui/react-select": "2.2.4",
    "@radix-ui/react-slot": "1.2.2",
    "@radix-ui/react-switch": "1.2.4",
    "@radix-ui/react-tabs": "1.1.11",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "google-auth-library": "11.1.0",
    "lucide-react": "0.321.0",
    "next": "14.2.28",
    "nodemailer": "10.0.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "2.6.0",
    "tailwindcss-animate": "1.0.7",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.52.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "14.3.1",
    "@testing-library/user-event": "14.6.7",
    "@types/jest": "29.5.14",
    "@types/node": "20.17.46",
    "@types/nodemailer": "8.0.2",
    "@types/react": "18.3.21",
    "@types/react-dom": "18.3.7",
    "autoprefixer": "10.4.21",
    "csv-parse": "7.0.2",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.28",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "postcss": "8.4.31",
    "prettier": "3.5.3",
    "prettier-plugin-tailwindcss": "0.5.7",
    "tailwindcss": "3.4.17",
    "tsx": "4.23.15",
    "typescript": "5.6.3"
  }
}
